{
  "name": "central-celular",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:capacitor": "VITE_CAPACITOR=true vite build",
    "build:mobile": "yarn build:capacitor && cap sync",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "preview": "vite preview --host",
    "dev:server": "tsx watch server/index.ts",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "tsx server/seed.js",
    "start:dev": "concurrently \"yarn dev:server\" \"yarn dev\"",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:server": "vitest run server",
    "test:integration": "vitest run server/tests/relatorios.test.ts",
    "test:watch": "vitest",
    "deploy:docker": "docker compose up -d --build",
    "deploy:docker:frontend": "docker compose up -d --build frontend",
    "deploy:docker:app": "docker compose up -d --build app",
    "generate:icons": "node -e \"require('fs').copyFileSync('src/assets/brand/logo-icon.svg','public/favicon.svg')\" && pwa-assets-generator --config pwa-assets.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/camera": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/haptics": "^7.0.1",
    "@capacitor/ios": "^7.2.0",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/network": "^7.0.1",
    "@capacitor/push-notifications": "^7",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@headlessui/vue": "^1.7.19",
    "@heroicons/vue": "^2.2.0",
    "@prisma/client": "^5.9.0",
    "@types/cron": "^2.4.3",
    "apexcharts": "^4.7.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.1",
    "confetti-js": "^0.0.18",
    "cors": "^2.8.5",
    "cron": "^4.3.1",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.8",
    "morgan": "^1.10.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.38",
    "vue-chartjs": "^5.3.0",
    "vue-confetti": "^2.3.0",
    "vue-router": "^4.2.5",
    "vue3-apexcharts": "^1.8.0",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.17",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-vue": "^5.1.3",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.31",
    "prisma": "^5.9.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.3.5",
    "tsx": "^4.7.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.4",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "pwa-assets": {
    "preset": "minimal-2023",
    "images": [
      "public/favicon.svg"
    ]
  },
  "prisma": {
    "seed": "node server/seed.js"
  }
}
