// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id          Int       @id @default(autoincrement())
  nome        String
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  usuarios    Usuario[]
  regioes     Regiao[]
  celulas     Celula[]
  whatsappConnections WhatsAppConnection[]
  otpCodes    OtpCode[]
  config      AccountConfig?

  @@map("accounts")
}

model Usuario {
  id                 Int       @id @default(autoincrement())
  nome               String
  email              String?   // Agora é opcional
  whatsapp           String    // Não é mais opcional
  senha              String?   // Agora é opcional inicialmente
  dataNascimento     DateTime? @map("data_nascimento") @db.Date
  cargo              String    // "admin", "pastor", "supervisor", "lider", "colider"
  ativo              Boolean   @default(true)
  isSuperAdmin       Boolean   @default(false) @map("is_super_admin")
  avatarUrl          String?   @map("avatar_url")
  accountId          Int       @map("account_id")
  account            Account   @relation(fields: [accountId], references: [id])
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  celulasLideradas   Celula[]  @relation("lider")
  celulasCoLideradas Celula[]  @relation("colider")
  celulasSupervisao  Celula[]  @relation("supervisor")
  notificacoes       Notificacao[]
  conquistas         Conquista[]
  config             UsuarioConfig?
  ssoLinks           SsoLink[]
  atribuicoesComoLider  AtribuicaoCuidado[] @relation("lider_rede")
  atribuicoesCriadas    AtribuicaoCuidado[] @relation("criador_rede")
  refreshTokens      RefreshToken[]
  deviceTokens       DeviceToken[]

  @@unique([email, accountId])
  @@unique([whatsapp, accountId])
  @@map("usuarios")
}

enum PublicoCelula {
  homens
  mulheres
  misto
  nao_informado
}

model Celula {
  id              Int           @id @default(autoincrement())
  nome            String
  publico         PublicoCelula @default(nao_informado)
  endereco        String?
  diaSemana       String        // "segunda", "terca", "quarta", "quinta", "sexta", "sabado", "domingo"
  horario         String
  liderId         Int           @map("lider_id")
  lider           Usuario       @relation("lider", fields: [liderId], references: [id])
  coLiderId       Int?          @map("colider_id")
  coLider         Usuario?      @relation("colider", fields: [coLiderId], references: [id])
  supervisorId    Int?          @map("supervisor_id")
  supervisor      Usuario?      @relation("supervisor", fields: [supervisorId], references: [id])
  regiaoId        Int?          @map("regiao_id")
  regiao          Regiao?       @relation(fields: [regiaoId], references: [id])
  accountId       Int           @map("account_id")
  account         Account       @relation(fields: [accountId], references: [id])
  ativo           Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  membros         Membro[]
  relatorios      Relatorio[]
  atribuicoesCuidado AtribuicaoCuidado[]

  @@map("celulas")
}

model Membro {
  id              Int           @id @default(autoincrement())
  celulaId        Int           @map("celula_id")
  celula          Celula        @relation(fields: [celulaId], references: [id])
  nome            String
  telefone        String?
  dataNascimento  DateTime?     @map("data_nascimento") @db.Date
  ehConsolidador  Boolean       @default(false) @map("eh_consolidador")
  ehCoLider       Boolean       @default(false) @map("eh_colider")
  ehAnfitriao     Boolean       @default(false) @map("eh_anfitriao")
  dataCadastro    DateTime      @default(now()) @map("data_cadastro")
  ativo           Boolean       @default(true)
  observacoes     String?
  presencas       Presenca[]
  cuidadoPor      AtribuicaoCuidado?  @relation("cuidado")
  cuidaDeAlguem   AtribuicaoCuidado[] @relation("consolidador")

  @@map("membros")
}

model Regiao {
  id              Int           @id @default(autoincrement())
  nome            String
  supervisorId    Int?          @map("supervisor_id")
  accountId       Int           @map("account_id")
  account         Account       @relation(fields: [accountId], references: [id])
  ativo           Boolean       @default(true)
  celulas         Celula[]

  @@map("regioes")
}

model Relatorio {
  id          Int       @id @default(autoincrement())
  celulaId    Int       @map("celula_id")
  celula      Celula    @relation(fields: [celulaId], references: [id])
  dataInicio  DateTime  @map("data_inicio")
  dataFim     DateTime  @map("data_fim")
  evento      Int       // 0 = célula, 1 = culto
  status      Int       // 0 = rascunho, 1 = enviado
  dataEnvio   DateTime? @map("data_envio")
  observacoes String?
  teveCelula  Boolean   @default(true) @map("teve_celula") // Indica se houve célula naquela semana
  presencas   Presenca[]

  @@unique([celulaId, dataInicio, dataFim, evento])
  @@map("relatorios")
}

model Presenca {
  id           Int       @id @default(autoincrement())
  relatorioId  Int       @map("relatorio_id")
  relatorio    Relatorio @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
  membroId     Int       @map("membro_id")
  membro       Membro    @relation(fields: [membroId], references: [id])
  status       Int       // 0 = ausente, 1 = presente
  tipo         Int       @default(0) // 0 = celula, 1 = culto

  @@unique([relatorioId, membroId, tipo])
  @@map("presencas")
}

model Notificacao {
  id              Int           @id @default(autoincrement())
  usuarioId       Int           @map("usuario_id")
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])
  titulo          String
  mensagem        String
  lida            Boolean       @default(false)
  dataCriacao     DateTime      @default(now()) @map("data_criacao")
  tipo            String        // "lembrete", "conquista", "informativo"

  @@map("notificacoes")
}

model Conquista {
  id              Int           @id @default(autoincrement())
  usuarioId       Int           @map("usuario_id")
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])
  tipo            String        // "lider_destaque", "assiduidade", "crescimento"
  descricao       String
  dataConclusao   DateTime      @default(now()) @map("data_conclusao")
  mes             Int
  ano             Int

  @@map("conquistas")
}

model WhatsAppConnection {
  id          Int      @id @default(autoincrement())
  name        String
  token       String   @unique
  status      String   @default("pending") // pending, connected, disconnected
  phoneNumber String?
  connectedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  accountId   Int
  account     Account  @relation(fields: [accountId], references: [id])

  @@map("whatsapp_connections")
}

model OtpCode {
  id          Int       @id @default(autoincrement())
  whatsapp    String
  code        String    // Código de 4 dígitos
  expiresAt   DateTime  // Data de expiração
  used        Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  accountId   Int       @map("account_id")
  account     Account   @relation(fields: [accountId], references: [id])

  @@map("otp_codes")
}

model UsuarioConfig {
  id                      Int       @id @default(autoincrement())
  usuarioId               Int       @unique @map("usuario_id")
  usuario                 Usuario   @relation(fields: [usuarioId], references: [id])
  notificacaoAniversarioAtiva Boolean @default(true) @map("notificacao_aniversario_ativa")
  diasAntecedencia1       Int       @default(3) @map("dias_antecedencia_1")
  diasAntecedencia2       Int       @default(0) @map("dias_antecedencia_2")
  notificacaoAniversarioLiderAtiva Boolean @default(false) @map("notificacao_aniversario_lider_ativa")
  diasAntecedenciaLider1  Int       @default(3) @map("dias_antecedencia_lider_1")
  diasAntecedenciaLider2  Int       @default(0) @map("dias_antecedencia_lider_2")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("usuario_configs")
}

model AccountConfig {
  id                      Int       @id @default(autoincrement())
  accountId               Int       @unique @map("account_id")
  account                 Account   @relation(fields: [accountId], references: [id])
  envioLinkSsoAtivo       Boolean   @default(false) @map("envio_link_sso_ativo")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("account_configs")
}

model SsoLink {
  id              Int       @id @default(autoincrement())
  token           String    @unique
  usuarioId       Int       @map("usuario_id")
  usuario         Usuario   @relation(fields: [usuarioId], references: [id])
  dataInicio      DateTime  @map("data_inicio")
  dataFim         DateTime  @map("data_fim")
  expiresAt       DateTime  @map("expires_at")
  usado           Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("sso_links")
}

model AtribuicaoCuidado {
  id              Int      @id @default(autoincrement())
  celulaId        Int      @map("celula_id")
  membroId        Int      @unique @map("membro_id")
  consolidadorId  Int?     @map("consolidador_id")
  liderId         Int?     @map("lider_id")
  criadoPorId     Int?     @map("criado_por_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  celula       Celula   @relation(fields: [celulaId], references: [id])
  membro       Membro   @relation("cuidado", fields: [membroId], references: [id])
  consolidador Membro?  @relation("consolidador", fields: [consolidadorId], references: [id])
  lider        Usuario? @relation("lider_rede", fields: [liderId], references: [id])
  criadoPor    Usuario? @relation("criador_rede", fields: [criadoPorId], references: [id])

  @@map("atribuicoes_cuidado")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  platform  String
  token     String   @unique
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("device_tokens")
}