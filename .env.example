# --- Formato legado (dev local / VPS simples) ---
# O Docker deriva POSTGRES_* do DATABASE_URL e ajusta o host para "db".
DATABASE_URL=postgresql://postgres:sua-senha@localhost:5432/central_db
NODE_ENV=development
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
VITE_QUEPASA_USER_EMAIL=seu_email@exemplo.com

# --- Produção (VPS): OBRIGATÓRIO antes do yarn build ---
# FRONTEND_URL=https://apriscoapp.com
# NODE_ENV=production
# VITE_API_URL=/api
# Depois: yarn build && docker compose up -d frontend
# NÃO use http://localhost:3000 no build da VPS — o browser chama SUA máquina, não o servidor.

# --- Opcional (compose usa padrão se omitir) ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=sua-senha
# POSTGRES_DB=central_db
# DB_HOST_PORT=5433
# APP_HOST_PORT=33000
# FRONTEND_PORT=8181
# QUEPASA_UPSTREAM=http://173.249.22.227:31000
# DOCKER_IMAGE=douglagoncalves/central-celular:latest
