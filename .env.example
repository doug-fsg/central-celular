# Copie para .env na VPS: cp .env.example .env

# --- Banco de dados ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=central_db

# --- Backend ---
# Obrigatório em produção: sem isso, rotas com accountMiddleware rejeitam o token (401 após login).
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
FRONTEND_URL=https://apriscoapp.com

# --- Frontend (usado no build do Vite) ---
# Docker/nginx na mesma origem: VITE_API_URL=/api
VITE_API_URL=https://apriscoapp.com/api
VITE_QUEPASA_USER_EMAIL=seu_email@exemplo.com

# --- Infra ---
FRONTEND_PORT=8181
QUEPASA_UPSTREAM=http://173.249.22.227:31000
