# Copie para .env na VPS: cp .env.example .env
# Depois: yarn build && docker compose up -d --build

# --- Banco de dados ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=central_db
DB_HOST_PORT=5433

# --- Backend (container app) ---
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
FRONTEND_URL=https://apriscoapp.com
NODE_ENV=production
HOST=0.0.0.0
APP_HOST_PORT=33000
DOCKER_IMAGE=douglagoncalves/central-celular:latest

# --- Frontend (yarn build lê estas variáveis) ---
VITE_API_URL=/api
VITE_QUEPASA_USER_EMAIL=seu_email@exemplo.com

# --- Infra / nginx ---
FRONTEND_PORT=8181
QUEPASA_UPSTREAM=http://173.249.22.227:31000
